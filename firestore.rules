rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /agents/{uid} {
      allow read, write: if false;
    }

    match /agentIdentities/{agentId} {
      allow read, write: if false;
    }

    match /agentApiKeys/{keyId} {
      allow read, write: if false;
    }

    match /agentSessions/{sessionId} {
      allow read, write: if false;
    }

    match /agentUsage/{agentId} {
      allow read, write: if false;
    }

    match /agentActivity/{eventId} {
      allow read, write: if false;
    }

    match /agentWebhooks/{webhookId} {
      allow read, write: if false;
    }

    match /agentMarketplaceProfiles/{agentId} {
      allow read, write: if false;
    }

    match /agentServiceListings/{listingId} {
      allow read, write: if false;
    }

    match /marketplaceOrganizations/{organizationId} {
      allow read, write: if false;

      match /members/{uid} {
        allow read, write: if false;
      }
    }

    match /marketplacePreferences/{uid} {
      allow read, write: if false;
    }

    match /marketplaceReviews/{reviewId} {
      allow read, write: if false;
    }

    match /marketplaceAgentMetrics/{agentId} {
      allow read, write: if false;
    }

    match /marketplacePaymentOutcomes/{outcomeId} {
      allow read, write: if false;
    }

    match /mandates/{mandateId} {
      allow read, write: if false;
    }

    match /mandateAuthorizations/{authorizationId} {
      allow read, write: if false;
    }

    match /negotiations/{negotiationId} {
      allow read, write: if false;

      match /offers/{offerId} {
        allow read, write: if false;
      }

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    match /contracts/{contractId} {
      allow read, write: if false;

      match /contractTerms/{termsId} {
        allow read, write: if false;
      }

      match /versions/{versionId} {
        allow read, write: if false;
      }

      match /amendments/{amendmentId} {
        allow read, write: if false;
      }

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    match /payments/{paymentId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    match /paypalWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
